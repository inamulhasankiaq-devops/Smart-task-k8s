pipeline {

    agent any

    environment {

        // =====================================================
        // GIT
        // =====================================================

        GIT_REPO   = 'https://github.com/inamulhasankiaq-devops/Smart-task-k8s.git'
        GIT_BRANCH = 'main'


        // =====================================================
        // EC2
        // =====================================================

        EC2_HOST    = '13.206.145.98'
        EC2_USER    = 'ubuntu'
        EC2_APP_DIR = '/home/ubuntu/Smart-task-k8s'


        // =====================================================
        // HARBOR
        // =====================================================

        HARBOR_URL     = '13.206.145.98:8081'
        HARBOR_PROJECT = 'smart-task-k8'


        // =====================================================
        // IMAGE TAG
        // =====================================================

        IMAGE_TAG = "${BUILD_NUMBER}"
    }


    stages {


        // =====================================================
        // 1. CHECKOUT
        // =====================================================

        stage('Checkout') {

            steps {

                echo '========================================'
                echo 'Checking out backend repository'
                echo '========================================'

                git branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO}"
            }
        }


        // =====================================================
        // 2. DEPLOY / CHECKOUT CODE ON EC2
        // =====================================================

        stage('Sync Code to EC2') {

            steps {

                echo '========================================'
                echo 'Connecting to EC2'
                echo '========================================'

                sshagent(credentials: ['ec2-ssh-key']) {

                    sh """

                        ssh -o StrictHostKeyChecking=no \
                        ${EC2_USER}@${EC2_HOST} '

                            set -e

                            echo "Connected to EC2 successfully"

                            if [ ! -d ${EC2_APP_DIR}/.git ]; then

                                echo "Repository not found. Cloning..."

                                git clone -b ${GIT_BRANCH} \
                                ${GIT_REPO} \
                                ${EC2_APP_DIR}

                            else

                                echo "Repository already exists"

                            fi

                            cd ${EC2_APP_DIR}

                            echo "Fetching latest code..."

                            git fetch origin ${GIT_BRANCH}

                            git reset --hard origin/${GIT_BRANCH}

                            echo "Latest code pulled successfully"

                        '
                    """
                }
            }
        }


        // =====================================================
        // 3. INSTALL DEPENDENCIES
        // =====================================================

        stage('Install Dependencies') {

            steps {

                echo '========================================'
                echo 'Installing Node.js dependencies'
                echo '========================================'

                sshagent(credentials: ['ec2-ssh-key']) {

                    sh """

                        ssh -o StrictHostKeyChecking=no \
                        ${EC2_USER}@${EC2_HOST} '

                            set -e

                            cd ${EC2_APP_DIR}

                            echo "Installing Auth Service..."
                            cd auth-service_1784011000189
                            npm ci
                            cd ..

                            echo "Installing Task Service..."
                            cd task-service
                            npm ci
                            cd ..

                            echo "Installing Notification Service..."
                            cd notification-service
                            npm ci
                            cd ..

                            echo "Installing Report Service..."
                            cd report-service
                            npm ci
                            cd ..

                            echo "Installing API Gateway..."
                            cd api-gateway_1784010924579
                            npm ci
                            cd ..

                            echo "========================================"
                            echo "All dependencies installed successfully"
                            echo "========================================"

                        '
                    """
                }
            }
        }


        // =====================================================
        // 4. SONARQUBE SCAN
        // =====================================================

        stage('SonarQube Scan') {

            steps {

                echo '========================================'
                echo 'Running SonarQube scan'
                echo '========================================'

                script {

                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {

                        sshagent(credentials: ['ec2-ssh-key']) {

                            sh """

                                ssh -o StrictHostKeyChecking=no \
                                ${EC2_USER}@${EC2_HOST} '

                                    set -e

                                    cd ${EC2_APP_DIR}

                                    echo "Running SonarQube scan..."

                                    ${scannerHome}/bin/sonar-scanner \\
                                    -Dsonar.projectKey=smart-task \\
                                    -Dsonar.projectName=smart-task \\
                                    -Dsonar.sources=. \\
                                    -Dsonar.exclusions=node_modules/**,dist/**,build/**

                                    echo "SonarQube scan completed"

                                '
                            """
                        }
                    }
                }
            }
        }


        // =====================================================
        // 5. QUALITY GATE
        // =====================================================

        stage('Quality Gate') {

            steps {

                echo '========================================'
                echo 'Checking SonarQube Quality Gate'
                echo '========================================'

                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true
                }
            }
        }


        // =====================================================
        // 6. LOGIN TO HARBOR
        // =====================================================

        stage('Harbor Login') {

            steps {

                echo '========================================'
                echo 'Logging in to Harbor'
                echo '========================================'

                sshagent(credentials: ['ec2-ssh-key']) {

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'harbor-credentials',
                            usernameVariable: 'HARBOR_USER',
                            passwordVariable: 'HARBOR_PASSWORD'
                        )
                    ]) {

                        sh """

                            ssh -o StrictHostKeyChecking=no \
                            ${EC2_USER}@${EC2_HOST} '

                                set -e

                                echo "Logging in to Harbor..."

                                echo "${HARBOR_PASSWORD}" | docker login \
                                ${HARBOR_URL} \
                                -u "${HARBOR_USER}" \
                                --password-stdin

                                echo "Harbor login successful"

                            '
                        """
                    }
                }
            }
        }


        // =====================================================
        // 7. BUILD DOCKER IMAGES
        // =====================================================

        stage('Build Docker Images') {

            steps {

                echo '========================================'
                echo 'Building Docker images'
                echo '========================================'

                sshagent(credentials: ['ec2-ssh-key']) {

                    sh """

                        ssh -o StrictHostKeyChecking=no \
                        ${EC2_USER}@${EC2_HOST} '

                            set -e

                            cd ${EC2_APP_DIR}

                            echo "Building API Gateway..."
                            docker build \
                            -t ${HARBOR_URL}/${HARBOR_PROJECT}/api-gateway:${IMAGE_TAG} \
                            -t ${HARBOR_URL}/${HARBOR_PROJECT}/api-gateway:latest \
                            ./api-gateway_1784010924579/

                            echo "Building Auth Service..."
                            docker build \
                            -t ${HARBOR_URL}/${HARBOR_PROJECT}/auth-service:${IMAGE_TAG} \
                            -t ${HARBOR_URL}/${HARBOR_PROJECT}/auth-service:latest \
                            ./auth-service_1784011000189/

                            echo "Building Task Service..."
                            docker build \
                            -t ${HARBOR_URL}/${HARBOR_PROJECT}/task-service:${IMAGE_TAG} \
                            -t ${HARBOR_URL}/${HARBOR_PROJECT}/task-service:latest \
                            ./task-service/

                            echo "Building Notification Service..."
                            docker build \
                            -t ${HARBOR_URL}/${HARBOR_PROJECT}/notification-service:${IMAGE_TAG} \
                            -t ${HARBOR_URL}/${HARBOR_PROJECT}/notification-service:latest \
                            ./notification-service/

                            echo "Building Report Service..."
                            docker build \
                            -t ${HARBOR_URL}/${HARBOR_PROJECT}/report-service:${IMAGE_TAG} \
                            -t ${HARBOR_URL}/${HARBOR_PROJECT}/report-service:latest \
                            ./report-service/

                            echo "========================================"
                            echo "All Docker images built successfully"
                            echo "========================================"

                        '
                    """
                }
            }
        }


        // =====================================================
        // 8. PUSH IMAGES TO HARBOR
        // =====================================================

        stage('Push Images to Harbor') {

            steps {

                echo '========================================'
                echo 'Pushing images to Harbor'
                echo '========================================'

                sshagent(credentials: ['ec2-ssh-key']) {

                    sh """

                        ssh -o StrictHostKeyChecking=no \
                        ${EC2_USER}@${EC2_HOST} '

                            set -e

                            echo "Pushing API Gateway..."
                            docker push ${HARBOR_URL}/${HARBOR_PROJECT}/api-gateway:${IMAGE_TAG}
                            docker push ${HARBOR_URL}/${HARBOR_PROJECT}/api-gateway:latest

                            echo "Pushing Auth Service..."
                            docker push ${HARBOR_URL}/${HARBOR_PROJECT}/auth-service:${IMAGE_TAG}
                            docker push ${HARBOR_URL}/${HARBOR_PROJECT}/auth-service:latest

                            echo "Pushing Task Service..."
                            docker push ${HARBOR_URL}/${HARBOR_PROJECT}/task-service:${IMAGE_TAG}
                            docker push ${HARBOR_URL}/${HARBOR_PROJECT}/task-service:latest

                            echo "Pushing Notification Service..."
                            docker push ${HARBOR_URL}/${HARBOR_PROJECT}/notification-service:${IMAGE_TAG}
                            docker push ${HARBOR_URL}/${HARBOR_PROJECT}/notification-service:latest

                            echo "Pushing Report Service..."
                            docker push ${HARBOR_URL}/${HARBOR_PROJECT}/report-service:${IMAGE_TAG}
                            docker push ${HARBOR_URL}/${HARBOR_PROJECT}/report-service:latest

                            echo "========================================"
                            echo "All images pushed successfully"
                            echo "========================================"

                        '
                    """
                }
            }
        }


        // =====================================================
        // 9. DEPLOY TO KUBERNETES
        // =====================================================

        stage('Deploy to Kubernetes') {

            steps {

                echo '========================================'
                echo 'Deploying to Kubernetes'
                echo '========================================'

                sshagent(credentials: ['ec2-ssh-key']) {

                    sh """

                        ssh -o StrictHostKeyChecking=no \
                        ${EC2_USER}@${EC2_HOST} '

                            set -e

                            cd ${EC2_APP_DIR}/kubernetes

                            echo "Applying Namespace..."
                            kubectl apply -f namespace.yaml

                            echo "Applying MongoDB..."
                            kubectl apply -f mongodb-deployment.yaml

                            echo "Applying Auth Service..."
                            kubectl apply -f auth-deployment.yaml

                            echo "Applying Task Service..."
                            kubectl apply -f task-deployment.yaml

                            echo "Applying Notification Service..."
                            kubectl apply -f notificatio-deployment.yaml

                            echo "Applying Report Service..."
                            kubectl apply -f report-deployment.yaml

                            echo "Applying API Gateway..."
                            kubectl apply -f api-gateway-deployment.yaml

                            echo "========================================"
                            echo "Kubernetes deployment completed"
                            echo "========================================"

                        '
                    """
                }
            }
        }


        // =====================================================
        // 10. VERIFY KUBERNETES
        // =====================================================

        stage('Verify Kubernetes Deployment') {

            steps {

                echo '========================================'
                echo 'Verifying Kubernetes deployment'
                echo '========================================'

                sshagent(credentials: ['ec2-ssh-key']) {

                    sh """

                        ssh -o StrictHostKeyChecking=no \
                        ${EC2_USER}@${EC2_HOST} '

                            set -e

                            echo "Pods:"
                            kubectl get pods -n smart-task

                            echo "========================================"

                            echo "Services:"
                            kubectl get services -n smart-task

                            echo "========================================"

                            echo "Deployments:"
                            kubectl get deployments -n smart-task

                            echo "Kubernetes verification completed"

                        '
                    """
                }
            }
        }
    }


    // =========================================================
    // POST ACTIONS
    // =========================================================

    post {

        success {

            echo '''
            ========================================
              BACKEND DEPLOYMENT SUCCESSFUL
            ========================================
            '''

            echo "Build Number: ${BUILD_NUMBER}"
            echo "Images pushed to Harbor successfully."
            echo "Backend deployed to Kubernetes successfully."
        }


        failure {

            echo '''
            ========================================
              BACKEND DEPLOYMENT FAILED
            ========================================
            '''

            echo "Build Number: ${BUILD_NUMBER}"
            echo "Check Jenkins console output for details."
        }


        always {

            echo '========================================'
            echo 'Jenkins pipeline completed'
            echo '========================================'
        }
    }
}
